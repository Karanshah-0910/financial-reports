# =============================================================
# FINANCIAL REPORTS .gitignore
# Files listed here are NEVER uploaded to GitHub.
# =============================================================

# ── SECRET KEYS — never, ever commit these ───────────────────
.env

# ── CLIENT DATA — real financial info and OAuth tokens ───────
# SQLite database (has QB refresh tokens + client emails)
clients.db
# QuickBooks OAuth tokens — treat like passwords
clients/tokens/
# Client JSON profiles (have emails and QB company IDs)
clients/*.json
# Raw and processed financial data from QuickBooks
data/raw/
data/processed/

# ── GENERATED REPORTS — PDFs with client financial data ──────
reports/
!reports/.gitkeep

# ── INSIGHT EXAMPLES — contain real client financial data ────
# input.json has raw QB numbers; draft.txt has generated commentary
# Only README.txt and folder structure are safe to commit
insight_examples/**/input.json
insight_examples/**/draft.txt
insight_examples/**/final.txt
insight_examples/**/metadata.json
# But keep the folder and its README visible on GitHub
!insight_examples/README.txt

# ── PYTHON INTERNALS — not needed on GitHub ──────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── LOGS — can contain client names and error details ────────
logs/
!logs/.gitkeep

# ── GENERATED DASHBOARD — contains your live MRR and client list ─
dashboard.html

# ── OLD / SUPERSEDED FILES — kept locally but not needed on GitHub
portal/
assets/
debug_auth_url.py
test_insights.py
test_qbo_connection.py
generate_all_reports.py
generate_insights.py

# ── TOOL AND OS FILES ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
# Claude Code project settings (local to your machine)
.claude/
