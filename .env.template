# -------------------------------------------------------
# COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES.
# NEVER commit .env to Git — it contains secret keys.
# -------------------------------------------------------

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- QuickBooks Online ---
# Get these from https://developer.intuit.com → My Apps → your app → Keys & OAuth
QB_CLIENT_ID=your_quickbooks_client_id_here
QB_CLIENT_SECRET=your_quickbooks_client_secret_here
QB_REDIRECT_URI=http://localhost:8000/callback
QB_ENVIRONMENT=sandbox          # Change to "production" when going live

# --- Report settings ---
REPORT_OUTPUT_DIR=reports/output
COMPANY_NAME=Your Company Name
REPORT_AUTHOR=Your Name

# --- Email delivery (optional — fill in when ready to email reports) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
